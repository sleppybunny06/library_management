# APP_URL: The public URL where this application is hosted.
# Used for self-referential links, callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# MONGODB_URI: Connection string for MongoDB.
# If omitted during local development, the server uses an in-memory database.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/libraryDB?retryWrites=true&w=majority"
